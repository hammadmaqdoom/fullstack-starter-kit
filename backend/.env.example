# Environment
TZ=UTC
NODE_ENV=local
IS_HTTPS=false
IS_WORKER=false

# Application
APP_NAME="Ultimate NestJS Boilerplate"
APP_URL=http://localhost:8000
APP_PORT=8000
APP_WORKER_PORT=8001
APP_DEBUG=false
APP_FALLBACK_LANGUAGE=en
APP_LOGGING=true
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://example.com
APP_LOCAL_FILE_UPLOAD=true

# Database
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_api
DATABASE_LOGGING=true
DATABASE_MAX_CONNECTIONS=250
DATABASE_SSL_MODE=disable
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=false
REDIS_CA=
REDIS_KEY=
REDIS_CERT=

# AWS
AWS_KEY=
AWS_SECRET=
AWS_S3_BUCKET=
AWS_REGION=

# Azure Blob Storage — [Optional] preferred over AWS S3 for document storage
# when set (tasks.md 0.1: Azure Blob storage adapter for documents). Leave
# blank to fall back to S3 (if configured) or local disk.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=polaris-documents

# Mailer
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=No Reply

# Authentication
AUTH_SECRET=secret
# Basic Auth: This is required to access swagger docs, auth api docs, bull-board dashboard, etc. routes.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin-password

# Microsoft Entra ID (employees) — register redirect URI: http://localhost:3000/api/auth/callback/microsoft
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# Demo personas (*.demo@digitaro.local) come from DemoOrgSeed via `pnpm seed:demo` /
# `pnpm seed:run` — use locally only; do not seed production Digitaro data.

# Entra lifecycle webhook (FLW-SEC-006) — shared secret checked against the
# `x-entra-webhook-secret` header on POST /api/v1/webhooks/entra. Required in
# any environment where the Entra Graph relay is enabled.
ENTRA_WEBHOOK_SECRET=

# GitHub OAuth: [Optional] Only include these if you want OAuth with GitHub. Otherwise, leave empty
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Graph (Teams adaptive card notifications) — [Optional] app registration with
# Application permissions Chat.Create + ChatMessage.Send, and a Teams "Application Access
# Policy" (Cloud Communications) granted to this app for the workers it messages.
# Leave empty to fall back to the stub client (send attempts are logged but not delivered).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Rate Limiter
THROTTLER_ENABLED=false
THROTTLER_LIMIT=3
THROTTLER_TTL=1 # In seconds

# Queue
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false
QUEUE_FAILED_RETRY_ATTEMPTS=3

# Sentry
SENTRY_DSN=
SENTRY_LOGGING=false

# E-sign PAdES sealing (FLW-DOC-003, PRD §6.12) — Azure Key Vault holds the
# signing certificate; private key never leaves the vault. Leave blank to
# disable real sealing (falls back to an explicit env-gated no-op).
AZURE_KEY_VAULT_URL=
ESIGN_SIGNING_CERT_NAME=
# Optional: service-principal auth for Key Vault. If unset, DefaultAzureCredential
# is used (managed identity in Azure, az/VS Code login locally).
AZURE_KEY_VAULT_TENANT_ID=
AZURE_KEY_VAULT_CLIENT_ID=
AZURE_KEY_VAULT_CLIENT_SECRET=
# Optional RFC 3161 TSA endpoint — when set, upgrades PAdES-B-B to PAdES-B-T.
ESIGN_TSA_URL=

# Grafana
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=grafana-password

# Docker
COMPOSE_PROFILES= # Available profiles = monitoring
